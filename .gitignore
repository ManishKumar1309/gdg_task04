# ==============================================================================
# ApexCRM - Git Ignore Rules
# ==============================================================================

# Node dependencies
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and sensitive data
.env
.env.local
.env.*.local

# Logs and runtime data
*.log
logs/

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Code Editor configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary & Build files
tmp/
temp/
.cache/
dist/
build/
